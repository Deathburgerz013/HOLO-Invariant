from holo_persistence import HoloInvariant
from holo_compressor import HoloCompressor

holo = HoloInvariant()

# Append with context
holo.append("System goal: Maintain bio/mech co-evolution invariant across resets.", 
            metadata={"type": "core_invariant", "compression": "v1"})

# Compress and store large state
large_state = "..."  # your long context / memory
compressed = HoloCompressor.compress_state(large_state)
holo.append(compressed, metadata={"compressed": True})

# Replay full history
history = holo.replay()
print("Reconstructed history:", history[-5:])  # last 5 entries

print(holo.get_state())

