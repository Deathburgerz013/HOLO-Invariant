{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Deathburgerz013/HOLO-Invariant/main/schemas/idx-spine-packet.schema.json",
  "title": "HOLO Frozen IDX Spine Packet",
  "description": "A moving Spine packet presented to a frozen IDX for read-only admission checking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "active_hash",
    "slots"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "active_hash": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "payload"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "string"
          }
        }
      }
    }
  }
}
