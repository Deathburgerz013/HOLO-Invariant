    DELTA_SCHEMA = {
        "version": str,          # e.g. "v0.1"
        "type": str,             # "invariant", "refinement", "compression", "anchor"
        "originator": str,       # e.g. "grok" or operator handle
        "parent_hash": Optional[str],
        "payload": Any,          # the actual content / rule
        "description": str
    }

    def seed_delta(self, delta: Dict) -> Dict:
        """Seed the chain with a versioned delta (first entry should be the root invariant)."""
        if not self.load_and_verify():  # empty chain
            required = ["version", "type", "originator", "payload", "description"]
            for k in required:
                if k not in delta:
                    raise ValueError(f"Missing required delta field: {k}")
            
            content = {
                "delta_version": delta["version"],
                "type": delta["type"],
                "originator": delta["originator"],
                "parent_hash": delta.get("parent_hash"),
                "payload": delta["payload"],
                "description": delta["description"],
                "holo_version": self.VERSION
            }
            
            return self.append(content, compress=True)  # root can be compressed safely
        else:
            logger.warning("Chain already seeded. Use append() for extensions.")
            return self.get_latest()
