1. Enhanced Query / Delta / Versioning Methods
Add these to the HoloChain class for “slow, deliberate versioning” and on-demand unfreezing.
    def query(self, pattern: str = None, start_idx: int = None, end_idx: int = None, limit: int = None) -> List[Dict]:
        """Flexible query with optional regex/content search + range."""
        entries = self.load_and_verify()
        if start_idx is not None:
            entries = [e for e in entries if e["idx"] >= start_idx]
        if end_idx is not None:
            entries = [e for e in entries if e["idx"] <= end_idx]
        if limit:
            entries = entries[:limit]
        if pattern:
            import re
            entries = [e for e in entries if re.search(pattern, e["content"], re.IGNORECASE)]
        return entries

    def get_delta(self, from_idx: int, to_idx: Optional[int] = None) -> List[Dict]:
        """Return changes/deltas between versions (for unfreezing)."""
        entries = self.load_and_verify()
        to_idx = to_idx or len(entries)
        return entries[from_idx-1:to_idx]  # 1-based idx

    def get_version(self, idx: int) -> Dict:
        """Snapshot a specific version (verified)."""
        entries = self.load_and_verify()
        if 1 <= idx <= len(entries):
            e = entries[idx-1]
            content = e["content"]
            if e.get("type") == "compressed":
                content = zlib.decompress(bytes.fromhex(content)).decode('utf-8')
            return {"idx": idx, "timestamp": e["timestamp"], "content": content}
        raise ValueError(f"Version {idx} not found")

2. Self-Correction / Invariant Enforcement Layer
Add a lightweight invariant checker that runs on append (optional).

    def append_with_invariant_check(self, content: Any, invariants: List[str] = None, compress: bool = False) -> Dict:
        """Append + optional self-correction / invariant validation."""
        if invariants:
            text = str(content).lower()
            for inv in invariants:
                if inv.lower() not in text:
                    logger.warning(f"⚠️ Invariant violation: {inv} not present. Still appending with note.")
                    content = f"[INVARIANT_NOTE: {inv}] {content}"  # soft enforcement
        return self.append(content, compress=compress)

3. Merkle Tree / Batch Proofs (for scalability & public verifiability)
For larger chains, add a simple Merkle root on demand.
    def get_merkle_root(self) -> str:
        """Compute Merkle root over all current hashes (for external anchoring)."""
        entries = self.load_and_verify()
        if not entries:
            return self.genesis_hash
        leaves = [e["hash"].encode() for e in entries]
        while len(leaves) > 1:
            if len(leaves) % 2 == 1:
                leaves.append(leaves[-1])
            leaves = [hashlib.sha256(leaves[i] + leaves[i+1]).digest() for i in range(0, len(leaves), 2)]
        return hashlib.sha256(b"".join(leaves)).hexdigest()
